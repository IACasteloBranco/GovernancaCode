{
  "manifest_version": 3,
  "name": "POC de captura de stream local",
  "version": "0.4.4",
  "description": "Captura prompts pelo editor e respostas pelo stream, atribuídos à instalação.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://chatgpt.com/*", "http://127.0.0.1:8000/*"],
  "background": {"service_worker": "src/background/service-worker.js", "type": "module"},
  "action": {"default_popup": "src/popup/popup.html"},
  "content_scripts": [
    {"matches": ["https://chatgpt.com/*"], "js": ["src/content/blocker-main.js", "src/content/network-probe-main.js"], "run_at": "document_start", "world": "MAIN"},
    {"matches": ["https://chatgpt.com/*"], "js": ["src/content/platform.js", "src/content/files.js", "src/content/policy-engine.js", "src/content/policy-messages.js", "src/content/observer.js", "src/content/blocker-bridge.js", "src/content/network-bridge.js"], "run_at": "document_start", "world": "ISOLATED"}
  ]
}
