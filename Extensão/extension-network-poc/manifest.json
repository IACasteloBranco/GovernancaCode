{
  "manifest_version": 3,
  "name": "Governança IA — POC Rede",
  "version": "0.3.3",
  "description": "POC experimental de bloqueio, captura observacional e espelhamento do stream do ChatGPT Web.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "src/background/service-worker.js", "type": "module"},
  "action": {"default_popup": "src/popup/diagnostics.html"},
  "content_scripts": [
    {"matches": ["https://chatgpt.com/*"], "js": ["src/content/blocker-main.js", "src/content/network-probe-main.js"], "run_at": "document_start", "world": "MAIN"},
    {"matches": ["https://chatgpt.com/*"], "js": ["src/content/platform.js", "src/content/files.js", "src/content/policy-engine.js", "src/content/policy-messages.js", "src/content/blocker-bridge.js", "src/content/network-bridge.js"], "run_at": "document_start", "world": "ISOLATED"},
    {"matches": ["https://chatgpt.com/*"], "js": ["src/content/observer.js"], "run_at": "document_idle", "world": "ISOLATED"}
  ]
}
